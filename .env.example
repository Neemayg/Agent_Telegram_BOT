# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key

# Telegram Bot Token (obtained from @BotFather)
BOT_TOKEN=your-telegram-bot-token

# Base URL of the deployment (e.g., https://your-app.up.railway.app)
# If left empty, the bot will use polling mode for local development.
BASE_URL=

# Port can be left undefined. It will fall back to os.getenv("PORT")
# or select an available port automatically in local development.
# PORT=8000
